{
	"name": "worker",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"build": "esbuild --bundle --platform=node --target=node20 --outfile=dist/index.js src/index.ts",
		"package": "docker run --rm -v $PWD:/worker $(docker build -q deb-build/) fpm",
		"start": "STAGE=DEV nodemon --watch src src/index.ts",
		"test": "jest"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@aws-sdk/client-auto-scaling": "^3.1000.0",
		"@aws-sdk/client-bedrock-runtime": "^3.1000.0",
		"@guardian/transcription-service-backend-common": "1.0.0",
		"@langchain/textsplitters": "1.0.1",
		"js-tiktoken": "1.0.21"
	},
	"devDependencies": {
		"@swc/core": "1.16.1",
		"@swc/jest": "0.2.39",
		"@types/jest": "29.5.13",
		"jest": "29.7.0",
		"undici": "5.22.0"
	},
	"jest": {
		"testEnvironment": "node",
		"transform": {
			"^.+\\.tsx?$": [
				"@swc/jest",
				{
					"jsc": {
						"parser": {
							"syntax": "typescript"
						}
					},
					"module": {
						"type": "commonjs"
					}
				}
			]
		},
		"testMatch": [
			"<rootDir>/src/**/*.test.ts"
		]
	}
}
